# Supabase API (Client & Server)
# NEXT_PUBLIC_* for Next.js, VITE_* for Vite dev preview
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Service Role (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# First Super Admin Seed Configuration
INITIAL_SUPER_ADMIN_EMAIL="superadmin@kobarexpo.id"
INITIAL_SUPER_ADMIN_PASSWORD="KobarExpo2026SuperAdmin!"
INITIAL_SUPER_ADMIN_NAME="Super Administrator Kobar Expo"

# Email Delivery (Resend API)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="Kobar Expo 2026 <no-reply@kobarexpo.id>"

# App URL
APP_URL="https://kobar-expo.vercel.app"
NEXT_PUBLIC_APP_URL="https://kobar-expo.vercel.app"
